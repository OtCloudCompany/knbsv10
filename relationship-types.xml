    <!--
        repository.knbs.or.ke relationship model.
 
        Based on the DSpace default relationship-types.xml, with all
        OrgUnit, Project, Journal, JournalVolume and JournalIssue
        relationships removed. Publication<->Person and Dataset<->Person /
        Dataset<->Publication relationships are kept as shipped.
 
        Added: a "report family" model for multi-part statistical
        publications such as KDHS 2022:
          - Publication (parent report) -> Publication (volume)
          - Publication (parent report) -> Publication (key indicators report)
          - Publication (parent report) -> FactSheet (county / national sheet)
 
        The FactSheet entity type does not exist in the default install;
        `dspace initialize-entities -f <this file>` will create it because
        it is referenced below.
 
        Convention: the LEFT side is always the parent report. leftwardType
        is the label shown on the LEFT item (what the linked right item is
        to it); rightwardType is the label shown on the RIGHT item.
    -->
 
    <!-- =====================================================
         Report-family relationships (KDHS 2022 and similar)
         ===================================================== -->
 
    <!-- Parent report -> Volume 1, Volume 2, ...
         A report may have many volumes; a volume belongs to at most
         one parent report (drop <max> on the right side if you would
         rather not enforce that). -->
    <type>
        <leftType>Publication</leftType>
        <rightType>Publication</rightType>
        <leftwardType>isVolumeOfReport</leftwardType>
        <rightwardType>isReportOfVolume</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
            <max>1</max>
        </rightCardinality>
    </type>
 
    <!-- Parent report -> Key Indicators Report -->
    <type>
        <leftType>Publication</leftType>
        <rightType>Publication</rightType>
        <leftwardType>isKeyIndicatorReportOfReport</leftwardType>
        <rightwardType>isReportOfKeyIndicatorReport</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
            <max>1</max>
        </rightCardinality>
    </type>
 
    <!-- Parent report -> County / national fact sheets -->
    <type>
        <leftType>Publication</leftType>
        <rightType>FactSheet</rightType>
        <leftwardType>isFactSheetOfReport</leftwardType>
        <rightwardType>isReportOfFactSheet</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
            <max>1</max>
        </rightCardinality>
    </type>
